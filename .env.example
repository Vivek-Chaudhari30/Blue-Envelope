# Blue Envelope — environment
# Copy to .env.local and fill in only what you need.
# The app runs FULLY with NONE of these set: on-device OCR + plain-code rules,
# plus the sample fallback whenever the AI guide isn't configured.

# --- Luna (AI guide) — optional, server-only, fallback/guide ONLY (never eligibility) ---
# Model id used by the Vercel AI SDK via the Vercel AI Gateway.
GUIDANCE_MODEL=openai/gpt-6-luna
# If you don't use the AI Gateway, set an OpenAI key and it will be used as a fallback.
OPENAI_API_KEY=
# Vercel AI Gateway key (when using the gateway). Set in Vercel project env, not here.
# AI_GATEWAY_API_KEY=

# --- Storage — optional. Without these, packet drafts live in localStorage (demo). ---
# Supabase holds ONLY shared packet summaries and partner sign-offs (no images, no OCR text).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notes:
# - Photos are read on-device (tesseract.js) and NEVER uploaded. No AWS keys are used.
# - Never commit real keys. Set production values in the Vercel dashboard (Project → Settings → Environment Variables).
