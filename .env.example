# Blue Envelope — environment
# Copy to .env.local and fill in only what you need. The app runs fully in mock mode with NONE of these set.

# Reader mode: "mock" (default) returns the sample letter and sample earnings so the demo works with no keys.
# "bedrock" uses AWS Textract + Bedrock.
READER_MODE=mock

# --- AWS (only needed when READER_MODE=bedrock) ---
AWS_REGION=us-east-1
# Bedrock model id for the Converse API (a Claude model).
BEDROCK_MODEL_ID=
# AWS credentials come from your environment / profile (aws configure or aws sso login). Never commit keys.

# --- Storage (optional; LocalStore/localStorage demo mode is used when these are unset) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
